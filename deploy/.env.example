# Copy to .env and generate eight independent secrets: control plane
# sessions, Gateway verification, tenant bootstrap, Console cookie
# encryption, the control plane's Registry TokenAdmin client (platform
# operator node-ops and node states — see AISW_REGISTRY_ADMIN_TOKEN below),
# the control plane's Fleet aggregation client (see AISW_GATEWAY_ADMIN_TOKEN
# below), the control plane's model-pull forwarding client (see
# AISW_GATEWAY_MODEL_PULL_TOKEN below), and the control plane's ComfyUI
# Managed forwarding client, which authenticates to the same listener the
# Gateway's ComfyUI Managed action/status endpoint exposes (see
# AISW_GATEWAY_COMFYUI_MANAGED_TOKEN below).
# 复制为 .env 并生成八个独立密钥，分别用于控制面会话、Gateway 校验、租户引导、
# Console Cookie 加密、控制面的 Registry TokenAdmin 客户端（平台运维的节点操作与
# 节点状态——见下面的 AISW_REGISTRY_ADMIN_TOKEN）、控制面的 Fleet 聚合客户端
# （见下面的 AISW_GATEWAY_ADMIN_TOKEN）、控制面的模型拉取转发客户端（见下面的
# AISW_GATEWAY_MODEL_PULL_TOKEN），以及控制面的 ComfyUI Managed 转发客户端——
# 它向的正是 Gateway 的 ComfyUI Managed 动作/状态端点所暴露的那个监听器（见下面
# 的 AISW_GATEWAY_COMFYUI_MANAGED_TOKEN），不要复用。
#
#   openssl rand -base64 32

AISW_ACCESS_SECRET=
AISW_INTERNAL_TOKEN=
AISW_BOOTSTRAP_TOKEN=
AISW_CONSOLE_SESSION_SECRET=

# Authenticates the control plane to the Registry's TokenAdmin service (must
# be at least 32 bytes, matching the Registry's own minimum). Without it, the
# platform operator's node-ops endpoints (approve/disable/enable a node,
# maintenance, and GET .../nodes/states) fail with a 500 — the control plane
# has no RegistryClient configured.
#
# 用于控制面向 Registry 的 TokenAdmin 服务表明身份（至少 32 字节，与 Registry 自身
# 的下限一致）。不填的话，平台运维的节点操作端点（批准/禁用/启用节点、维护模式，以及
# GET .../nodes/states）都会因为控制面没有配置 RegistryClient 而返回 500。
AISW_REGISTRY_ADMIN_TOKEN=

# Authenticates the control plane to each Gateway replica's read-only
# operator inventory listener (-admin-addr). Without it, the platform
# operator's fleet pages — nodes, models, routing/workflow-template status,
# jobs — fail with a 404 (fleet.ErrDisabled: the control plane has no Fleet
# aggregator configured).
#
# 用于控制面向各 Gateway 副本的只读运维清单监听器（-admin-addr）表明身份。不填的话，
# 平台运维的机群页面——节点、模型、路由/工作流模板状态、job——都会因为控制面没有配置
# Fleet 聚合器而返回 404（fleet.ErrDisabled）。
AISW_GATEWAY_ADMIN_TOKEN=

# Authenticates the control plane to each Gateway replica's model-pull write
# listener (-model-pull-addr, STATUS.md's P2 model distribution subtask
# two) — a separate listener and a separate token from
# AISW_GATEWAY_ADMIN_TOKEN above, since one triggers node downloads and the
# other only reads an inventory. Without it, the platform operator's
# model-pull endpoints (POST/GET .../nodes/:id/model-pulls) are not mounted
# at all (the same "no config, no route" rule Fleet follows), not present
# with a "not configured" answer.
#
# 用于控制面向各 Gateway 副本的模型拉取写监听器（-model-pull-addr，STATUS.md
# 的 P2 模型分发子任务二）表明身份——与上面的 AISW_GATEWAY_ADMIN_TOKEN 是不同
# 的监听器、不同的 token，因为一个会触发节点下载，另一个只读清单。不填的话，
# 平台运维的模型拉取端点（POST/GET .../nodes/:id/model-pulls）根本不会挂载
# （与 Fleet 相同的"没配置就没有路由"规则），而不是存在但回答"未配置"。
AISW_GATEWAY_MODEL_PULL_TOKEN=

# Authenticates both the control plane's forwarding client and a direct
# caller against each Gateway replica's ComfyUI Managed write listener
# (-comfyui-managed-addr, STATUS.md's P2 ComfyUI Managed Docker deployment
# subtask two) — a separate listener and a separate token from
# AISW_GATEWAY_MODEL_PULL_TOKEN above, since one applies a start/stop/restart
# action to a node's container and the other triggers a model download, with
# different blast radii if leaked. The control plane's ComfyUIManaged
# forwarding layer (deploy/controlplane.yaml's ComfyUIManaged block) uses
# this same value as its GatewayToken — the two sides must match. Without
# it, POST/GET .../operator/v1/nodes/:id/comfyui-managed is not mounted at
# all on the control plane (the same "no config, no route" rule model-pull
# follows), and a direct Gateway call has nothing to authenticate with
# either.
#
# 用于控制面的转发客户端与直接调用方，共同向各 Gateway 副本的 ComfyUI
# Managed 写监听器（-comfyui-managed-addr，STATUS.md 的 P2 ComfyUI Managed
# Docker 部署子任务二）表明身份——与上面的 AISW_GATEWAY_MODEL_PULL_TOKEN 是
# 不同的监听器、不同的 token，因为一个是对节点容器施加启停/重启动作，另一个
# 是触发模型下载，泄漏后果的爆炸半径不同。控制面的 ComfyUIManaged 转发层
# （deploy/controlplane.yaml 的 ComfyUIManaged 配置块）用的是同一个值作为
# GatewayToken——两边必须一致。不填的话，控制面上的 POST/GET
# .../operator/v1/nodes/:id/comfyui-managed 根本不会挂载（与模型拉取相同的
# "没配置就没有路由"规则），直接对 Gateway 的调用也没有可用于认证的值。
AISW_GATEWAY_COMFYUI_MANAGED_TOKEN=

# Optional: fill these in and the one-shot "bootstrap" service creates this
# tenant and owner automatically on `docker compose up`, so you can log into
# Console without a manual curl. Leave AISW_DEFAULT_OWNER_EMAIL empty to skip
# it — nothing is created automatically by default. Safe to leave set after
# the first run: a second attempt finds the account already exists and does
# nothing.
#
# 可选：填了这三行，一次性的 "bootstrap" 服务会在 `docker compose up` 时自动创建这个
# 租户和 owner，不用再手动跑一遍 curl 就能登录 Console。留空 AISW_DEFAULT_OWNER_EMAIL
# 则跳过——默认不会自动创建任何账号。首次创建后继续留着这三行也没问题：再次执行会发现
# 账号已存在，什么也不做。
AISW_DEFAULT_TENANT_NAME=Default
AISW_DEFAULT_OWNER_EMAIL=
AISW_DEFAULT_OWNER_PASSWORD=

# Optional, independent of the tenant owner above: fill AISW_DEFAULT_OPERATOR_EMAIL
# and the same "bootstrap" service also creates a platform operator account
# (the "平台运维" role, separate from tenant users — see the control plane
# README's "平台运维身份" section). Uses the same AISW_BOOTSTRAP_TOKEN; no
# separate secret. Leave empty to skip — nothing is created by default.
#
# 可选，独立于上面的租户 owner：填了 AISW_DEFAULT_OPERATOR_EMAIL，同一个
# "bootstrap" 服务也会创建一个平台运维账户（区别于租户用户的"平台运维"角色，见控制面
# README「平台运维身份」一节）。复用同一个 AISW_BOOTSTRAP_TOKEN，没有独立密钥。留空
# 则跳过——默认不会自动创建。
AISW_DEFAULT_OPERATOR_EMAIL=
AISW_DEFAULT_OPERATOR_PASSWORD=
AISW_DEFAULT_OPERATOR_NAME=Admin

# Compose serves the Console over local HTTP. Set true when using HTTPS.
# Compose 默认通过本地 HTTP 提供 Console；使用 HTTPS 时设为 true。
AISW_CONSOLE_COOKIE_SECURE=false
CONSOLE_PORT=3000

# Agent 拨向 Gateway 隧道的地址。默认值只在 Agent 与这套 compose 跑在同一台机器上
# 时成立；NAT 或负载均衡在前面时必须显式设置。
#
# The address an Agent dials for the Gateway's tunnel. The default only holds
# when the Agent runs on the same machine as this stack; set it explicitly once
# NAT or a load balancer sits in front.
GATEWAY_ADVERTISE_ADDR=127.0.0.1:8443

# 可选覆盖 / Optional overrides
# LOG_LEVEL=info
# POSTGRES_USER=aiserveweave
# POSTGRES_PASSWORD=aiserveweave
# POSTGRES_DB=aiserveweave

# Default MySQL 9.7 database settings / 默认 MySQL 9.7 数据库配置
# MYSQL_PORT=3306
# MYSQL_DATABASE=aiserveweave
# MYSQL_USER=aiserveweave
# MYSQL_PASSWORD=aiserveweave
# MYSQL_ROOT_PASSWORD=aiserveweave

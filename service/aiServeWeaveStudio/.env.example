# Studio 服务端配置示例。复制为 .env.local 后按部署修改。
# 这些变量只在 Next.js 服务端读取，均不带 NEXT_PUBLIC_ 前缀，不会进入浏览器包。
# 本文件不含任何真实密钥，可以提交。

# 控制面基地址。Studio 只用它登录与登出（/admin/v1/auth/*）。
AISW_STUDIO_CONTROL_PLANE_URL=http://127.0.0.1:8090

# Gateway 基地址。其余一切经 Gateway 的 Studio API（/studio/v1），Gateway 须以 -studio 启动。
AISW_STUDIO_GATEWAY_URL=http://127.0.0.1:8080

# 会话 Cookie 的密封密钥，至少 32 个字符。生产必须设置，且不要与 Console 共用同一个值。
# 生成方式：openssl rand -base64 48
AISW_STUDIO_SESSION_SECRET=

# 会话 Cookie 是否只在 HTTPS 下发送。默认跟随 NODE_ENV：生产为 true，开发为 false。
# AISW_STUDIO_COOKIE_SECURE=true

# 单次上游调用的超时（毫秒），默认 10000。
# AISW_STUDIO_UPSTREAM_TIMEOUT_MS=10000

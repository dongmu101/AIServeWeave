# Console 服务端配置示例。复制为 .env.local 后按部署修改。
# 这些变量只在 Next.js 服务端读取，均不带 NEXT_PUBLIC_ 前缀，不会进入浏览器包。
# 本文件不含任何真实密钥，可以提交。

# 控制面 Admin API 的基地址。Console 只连这一个上游，浏览器无法指定它。
AISW_CONSOLE_CONTROL_PLANE_URL=http://127.0.0.1:8090

# 会话 Cookie 的密封密钥，至少 32 个字符，仅 Console 服务端持有。
# 生产必须设置；未设置时开发环境会使用进程级临时密钥，重启后会话失效。
# 生成方式：openssl rand -base64 48
AISW_CONSOLE_SESSION_SECRET=

# 会话 Cookie 是否只在 HTTPS 下发送。默认跟随 NODE_ENV：生产为 true，开发为 false。
# 生产部署在 HTTPS 之后时不要改成 false。
# AISW_CONSOLE_COOKIE_SECURE=true

# 单次控制面调用的超时（毫秒），默认 10000。
# AISW_CONSOLE_UPSTREAM_TIMEOUT_MS=10000

# 平台运维使用 /operator/login 与独立的平台账户，不使用部署 token 或邮箱名单。
# Cookie 复用上面的密封主密钥，但按用途派生独立加密密钥；退出任一会话不清除另一会话。
# 节点清单依赖控制面 Fleet 配置，节点审批/维护依赖控制面 Registry 配置。

+func canonicalBetaFeatures(raw string) string {
+	if raw == "" {
+		return ""
+	}
+	names := strings.Split(raw, ",")
+	for i := range names {
+		names[i] = strings.TrimSpace(names[i])
+		if names[i] == "" {
